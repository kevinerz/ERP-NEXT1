PORT=3100
HOST=0.0.0.0
# Kunci bersama dengan ERP (WA_GATEWAY_KEY di .env ERP) — header X-Api-Key dua arah
API_KEY=
WEBHOOK_URL=http://192.168.200.221:3000/api/wa/webhook
AKUN=helpdesk
DATA_DIR=/opt/wa-gateway/data
MAX_MEDIA_MB=100
JEDA_MIN_MS=1200
JEDA_MAX_MS=2500
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=warn
