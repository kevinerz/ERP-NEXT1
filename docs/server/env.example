# ── Database ───────────────────────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/erp_next1"

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET="ganti-dengan-random-string-64-karakter"
JWT_REFRESH_SECRET="ganti-dengan-random-string-64-karakter"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# ── App ────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN="https://1erp.nextone.id,https://portal.nextone.id,capacitor://localhost"

# ── Email (SMTP Hostinger) ─────────────────────────────────────
MAIL_HOST="smtp.hostinger.com"
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER="noreply@nextone.id"
MAIL_PASSWORD="password-email"
MAIL_FROM="ERP NEXT1 <noreply@nextone.id>"

# ── PRTG ───────────────────────────────────────────────────────
PRTG_POLL_ENABLED=true
